# Copy this file to resume/master_resume.yaml and fill in your real resume.
# master_resume.yaml is gitignored - it's personal data, never committed.
#
# Validated against jobapply/resume/schema.py (ResumeDocument). Used by:
# Agent 1 (free-form context for fit scoring), Agent 2/2b (tailoring +
# fabrication audit), the PDF renderer, and Agent 3 (first_name/last_name/
# phone/email get filled into real application forms - keep these accurate).

contact:
  first_name: "Your"
  last_name: "Name"
  email: "you@example.com"
  phone: "+1 555 555 5555"
  location: "City, Country"
  links:
    - "https://linkedin.com/in/you"
    - "https://github.com/you"

summary: >
  One or two sentences describing your professional focus and years of
  experience - this frames how Agent 1 judges seniority/fit.

skills:
  - Python
  - FastAPI
  - PostgreSQL

experience:
  - company: "Example Corp"
    title: "Senior Software Engineer"
    start_date: "2022-01"
    end_date: "present"
    location: "Remote"
    bullets:
      - "Description of a real, verifiable accomplishment with a metric where you have one."
      - "Another real accomplishment."

education:
  - institution: "State University"
    degree: "B.S. Computer Science"
    end_date: "2018"

constraints:
  # Anything Agent 1 should treat as a hard filter or red-flag trigger,
  # e.g. sponsorship needs, minimum comp, timezone limits.
  requires_visa_sponsorship: false
  minimum_salary_usd: null
