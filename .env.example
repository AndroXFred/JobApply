# Only needed for headless/scripted first-run seeding. Once /setup has run,
# these values live in the settings DB table and are edited on the Settings page.
GEMINI_API_KEY=
RAPIDAPI_KEY=
NTFY_TOPIC=
NTFY_TOKEN=
DASHBOARD_PASSWORD=
LOCAL_LLM_API_KEY=not-needed

# App session secret (cookie signing) - generate a random string
SECRET_KEY=

# SQLite path override (defaults to data/jobapply.db)
DATABASE_PATH=
